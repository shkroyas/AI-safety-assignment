# Copy to .env and fill in. .env is gitignored.
HOSTED_PROVIDER=bedrock            # bedrock | mock
HOSTED_MODEL=us.anthropic.claude-opus-4-6-v1
BEDROCK_REGION=us-east-1
BEDROCK_API_KEYS=                  # Amazon Bedrock API key (bearer token)
HF_TOKEN=                          # Hugging Face token (Prompt Guard 2 licence accepted)
